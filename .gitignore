# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# ===== 환경변수 / 비밀키 (절대 커밋 금지) =====
.env
.env.*
# .env.example 템플릿은 커밋 허용
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json
# 프론트 구글맵 키 주입 파일(사용 시)
**/maps_key.js

# ===== 데이터베이스 / 스크래핑 데이터 =====
*.db
*.sqlite
*.sqlite3
menu_wise.db
# WAL 모드 부수 파일(머신 로컬, 커밋 금지)
*.db-wal
*.db-shm
*.db-journal

# ===== 크롤러 산출물(파이프라인 미사용 덤프 — 일부는 키 포함 가능) =====
# 사진 URL 쿼리스트링에 실제 Google API 키가 섞일 수 있어 패턴으로 차단.
# (해당 덤프 파일들은 삭제했으나 재생성 대비 패턴으로 계속 무시한다.)
crawler/*_preview.txt
crawler/*_candidates.txt
crawler/apify_*.json

# ===== Flutter 빌드/도구 산출물 =====
# (frontend/.gitignore가 처리하지만 루트에서도 방어적으로 무시)
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# ===== IDE / OS =====
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# ===== 추가 방어: 키 유출 예방 하드닝 =====
# 로그/백업에 키가 찍힐 수 있어 무시
*.log
*.bak
*.tmp
# 일반 비밀 파일 패턴(파일명에 secret/credential 포함 시)
*secret*.json
*credential*.json
*token*.json

# ===== Android (코드 아님: 머신별 경로 / 빌드 산출물 / 서명키) =====
# (frontend/android/.gitignore도 처리하지만 루트에서도 방어적으로 무시)
**/local.properties
**/.gradle/
**/.cxx/
**/captures/
frontend/android/**/build/
gradle-wrapper.jar
# 서명키·키스토어는 절대 커밋 금지 (앱 서명 비밀)
*.jks
*.keystore
key.properties
keystore.properties
# Firebase / Google 서비스 설정(프로젝트 키 포함될 수 있음)
**/google-services.json
**/GoogleService-Info.plist

# ===== 발표/문서 자산 (코드 아님) =====
architecture_diagram.png
architecture_diagram.html
